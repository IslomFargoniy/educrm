[Unit]
Description=EduCrm Hikvision ISUP 5.0 gateway
After=network.target

[Service]
Type=simple
User=root
EnvironmentFile=/opt/educrm-isup/educrm-isup.env
Environment=LD_LIBRARY_PATH=/opt/educrm-isup/lib
WorkingDirectory=/opt/educrm-isup
ExecStart=/opt/educrm-isup/educrm-isup
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
