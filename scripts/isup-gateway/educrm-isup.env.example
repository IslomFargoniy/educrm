# Where the gateway reaches the CRM (nginx) and the Host header it sends.
CRM_HOST=crm.mensalc.uz
CRM_PORT=80
CRM_HOSTNAME=crm.mensalc.uz
# CRM domain the devices use (resolved at start; restart the service after moving to another server).
PUBLIC_ADDRESS=crm.mensalc.uz
CMS_PORT=7660
ALARM_PORT=7662
# Local REST API the CRM calls; keep it on 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=7671
# Same value as ISUP_GATEWAY_TOKEN in the CRM .env.
GATEWAY_TOKEN=
